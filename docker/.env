# Default build-time values for docker-compose.yml.
#
# container.sh overrides HOST_UID/HOST_GID with your real host uid/gid at build
# time. These defaults are what the VS Code devcontainer uses, so if your host
# user is NOT uid/gid 1000, set them here to keep files editable without sudo:
#
#   id -u   # -> HOST_UID
#   id -g   # -> HOST_GID
HOST_UID=1000
HOST_GID=1000
