<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>soa_rosetta</name>
  <version>0.0.0</version>
  <description>Config files and scripts for using rosetta packages with LeRobot policies on the SOA robot</description>
  <maintainer email="42076119+htchr@users.noreply.github.com">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <!-- Python runtime -->
  <exec_depend>rclpy</exec_depend>

  <!-- ROS2 message types used by the action relay node and contract -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- Python libraries used by converters -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
