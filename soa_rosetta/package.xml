<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>soa_rosetta</name>
  <version>0.0.0</version>
  <description>SOA robot Rosetta contracts for LeRobot policy inference</description>
  <maintainer email="42076119+htchr@users.noreply.github.com">ubuntu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rosetta</exec_depend>
  <exec_depend>lerobot_robot_rosetta</exec_depend>
  <exec_depend>rosetta_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
